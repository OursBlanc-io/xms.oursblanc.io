{
    "name": "oursblanc-io/xms",
    "description": "AI-drivable block-based CMS for Laravel, powered by Filament v5",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "cms", "mcp", "ai"],
    "homepage": "https://github.com/OursBlanc-io/xms.oursblanc.io",
    "authors": [
        {
            "name": "OursBlanc",
            "email": "serna@oursblanc.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "filament/filament": "^5.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OursBlanc\\Xms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OursBlanc\\Xms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OursBlanc\\Xms\\XmsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
